# Kopier til .env og fyll inn egne verdier. .env committes aldri.
SECRET_KEY=bytt-meg-til-en-lang-tilfeldig-streng
# Valgfritt: SQLite-fil. Relative stier regnes fra instance-mappen, så standardverdien
# under gir instance/ektemat.db. Bruk en absolutt sti for å legge den et annet sted.
# DATABASE=ektemat.db

# Testpassord som brukes av `flask --app app seed` (kun for lokale, syntetiske testbrukere)
SEED_ADMIN_PASSWORD=admin-test-1234
SEED_CUSTOMER_PASSWORD=kunde-test-1234

# --- Lagring (Oblig 5) -------------------------------------------------------
# "sqlite" (standard) eller "neo4j". Neo4j startes med `docker compose up -d`.
STORAGE_BACKEND=sqlite

# Neo4j for appen (containeren neo4j-dev i docker-compose.yml). Passordet må ha minst 8 tegn
# og settes før containeren startes første gang.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=bytt-meg-dev-passord
NEO4J_DATABASE=neo4j

# Egen Neo4j for testene (containeren neo4j-test). Testene TØMMER denne databasen.
# Brukes med: TEST_STORAGE_BACKEND=neo4j pytest
NEO4J_TEST_URI=bolt://localhost:7688
NEO4J_TEST_PASSWORD=bytt-meg-test-passord
