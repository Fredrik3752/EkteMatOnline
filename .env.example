# Kopier til .env og fyll inn egne verdier. .env committes aldri.
SECRET_KEY=bytt-meg-til-en-lang-tilfeldig-streng
# Valgfritt: SQLite-fil. Relative stier regnes fra instance-mappen, så standardverdien
# under gir instance/ektemat.db. Bruk en absolutt sti for å legge den et annet sted.
# DATABASE=ektemat.db

# Testpassord som brukes av `flask --app app seed` (kun for lokale, syntetiske testbrukere)
SEED_ADMIN_PASSWORD=admin-test-1234
SEED_CUSTOMER_PASSWORD=kunde-test-1234
